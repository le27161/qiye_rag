# 运行环境标识：dev / test / staging / production
APP_ENV=dev
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 当前激活的业务场景 ID（对应 scenarios/ 目录下的场景配置）
ACTIVE_SCENARIO_ID=enterprise_knowledge
# FastAPI 服务监听端口
API_PORT=8000
# 环境文件类型标记（用于 Docker Compose 识别）
ENV_FILE=.env.compose

# Compose mode: run FastAPI inside docker compose, access dependencies by service name.
# MySQL 数据库连接配置（Docker Compose 模式下使用 service name 访问）
MYSQL_HOST=mysql
MYSQL_PORT=3306
# 宿主机映射端口（避免与本地 MySQL 冲突）
MYSQL_PUBLISHED_PORT=13307
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=subjects_kg

# 缓存开关：是否启用 Redis 查询缓存
CACHE_ENABLED=true
# Redis 连接配置（Docker Compose 模式下使用 service name 访问）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 缓存键前缀，用于多环境隔离
CACHE_KEY_PREFIX=kf:v1
# 一级缓存（命名空间查询）TTL：秒
CACHE_NAMESPACE_L1_TTL_SECONDS=3
# FAQ 直出答案缓存 TTL：秒
CACHE_FAQ_TTL_SECONDS=1800
# 文档检索结果缓存 TTL：秒
CACHE_DOC_TTL_SECONDS=900
# Embedding 向量缓存 TTL：秒
CACHE_EMBEDDING_TTL_SECONDS=3600

# Milvus 向量数据库连接 URI（Docker Compose 模式下使用 service name）
MILVUS_URI=http://milvus:19530
MILVUS_DATABASE=
MILVUS_PUBLISHED_PORT=19530
MILVUS_HEALTH_PUBLISHED_PORT=9091

# MinIO 对象存储端口映射
MINIO_API_PUBLISHED_PORT=9000
MINIO_CONSOLE_PUBLISHED_PORT=9001

# LLM 模型名称（DashScope 通义千问系列）
LLM_MODEL=qwen-plus
# DashScope API Key（请替换为真实可用的模型服务 Key）
DASHSCOPE_API_KEY=请替换为真实可用的模型服务 Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM 生成温度：越低越确定，越高越有创造力
LLM_TEMPERATURE=0.1
# LLM 请求超时时间：秒
LLM_TIMEOUT=60

# LangSmith 链路追踪配置（可选，用于调试和评估）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=请替换为 LangSmith API Key
LANGSMITH_PROJECT=knowforge-rag-platform
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Embedding 模型路径（容器内路径）
EMBEDDING_MODEL_PATH=/app/models/bge-m3
# Reranker（重排序）模型路径
RERANKER_MODEL_PATH=/app/models/bge-reranker-large
# BERT 意图分类模型路径
INTENT_MODEL_PATH=/app/models/bert_intent_classifier_v1
# 各模型版本标识（用于日志追踪和模型切换）
EMBEDDING_MODEL_VERSION=bge-m3-local-v1
RERANKER_MODEL_VERSION=bge-reranker-large-local-v1
INTENT_MODEL_VERSION=bert-intent-v1
# 意图分类模型运行设备：cpu / cuda
INTENT_MODEL_DEVICE=cpu
# 意图分类模型输入最大 token 长度
INTENT_MODEL_MAX_LENGTH=64
# 文档块切分策略版本
CHUNK_SCHEMA_VERSION=parent_child_validity_v2
# 文档解析后端：native（内置）或 docling
DOCUMENT_PARSER_BACKEND=native

# 客服联系电话（用于转人工场景）
CUSTOMER_SERVICE_PHONE=12345678
# CORS 跨域允许的域名列表（JSON 数组格式）
CORS_ALLOW_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# 管理后台 API 令牌（请替换为随机长令牌）
ADMIN_API_TOKEN=请替换为随机长令牌
# API 速率限制：每分钟最大请求数
API_RATE_LIMIT_PER_MINUTE=120
