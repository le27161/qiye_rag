# Mini RAG local configuration.
# Copy this file to .env before running locally:
#   copy .env.example .env

ACTIVE_SCENARIO_ID=enterprise_knowledge

# Local host defaults. docker-compose.yml overrides these to service names.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=subjects_kg
MILVUS_URI=http://127.0.0.1:19530

# Model paths. In Docker, these are usually mounted to /app/models.
EMBEDDING_MODEL_PATH=models/bge-m3
RERANKER_MODEL_PATH=models/bge-reranker-large
EMBEDDING_MODEL_VERSION=bge-m3-local-v1
RERANKER_MODEL_VERSION=bge-reranker-large-local-v1
CHUNK_SCHEMA_VERSION=mini-recursive-v1

# OpenAI-compatible LLM gateway. DashScope example:
DASHSCOPE_API_KEY=replace_with_your_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1

# Retrieval knobs for teaching and experiments.
RETRIEVAL_VARIANT_MAX=2
FAQ_TOP_K=20
DOC_TOP_K=20
RERANK_TOP_N=8
FINAL_CONTEXT_TOP_N=5
FAQ_DIRECT_SCORE_THRESHOLD=0.84
RAG_MIN_SCORE_THRESHOLD=0.2
MAX_PROMPT_CONTEXT_CHARS=5000

# docker-compose.yml uses this host path for the model volume.
# When mini-rag is inside the full repo, ../models is correct.
MINI_RAG_MODELS_DIR=../models
MINI_RAG_API_PORT=8010
MINI_RAG_MYSQL_PORT=3307
MINI_RAG_MILVUS_PORT=19540
MINI_RAG_MINIO_PORT=9010
MINI_RAG_MINIO_CONSOLE_PORT=9011
