<article class="post single">
  <p class="post-meta"><time><%= date(page.date, 'YYYY-MM-DD') %></time><% if (page.categories && page.categories.length) { %> · <%= page.categories.map(c => c.name).join(' / ') %><% } %></p>
  <h1><%= page.title %></h1>
  <div class="post-content"><%- page.content %></div>
  <% if (theme.comments && theme.comments.enable) { %>
    <section class="comments"><h3>评论</h3><div id="waline"></div>
      <% if (theme.comments.serverURL) { %>
      <script src="https://unpkg.com/@waline/client@v3/dist/waline.js"></script>
      <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css">
      <script>Waline.init({ el: '#waline', serverURL: '<%= theme.comments.serverURL %>' })</script>
      <% } else { %><p class="muted">评论功能已预留。请在 <code>_config.yml</code> 填写 Waline serverURL。</p><% } %>
    </section>
  <% } %>
</article>
